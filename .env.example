# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running the stack.
#
#   cp .env.example .env        (Linux / macOS / Git Bash)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Downloads folder (REQUIRED) ───────────────────────────────────────────────
# The host path to your OS Downloads folder. Docker Compose mounts this into
# the backend container at /downloads so downloaded files appear on your desktop.
#
# Linux / macOS:
#   DOWNLOADS_ROOT_HOST=/home/yourname/Downloads
#   DOWNLOADS_ROOT_HOST=${HOME}/Downloads      ← shell expansion in Compose
#
# Windows — Docker Desktop (WSL2 back-end) translates Windows paths:
#   DOWNLOADS_ROOT_HOST=C:/Users/YourName/Downloads
#   (use forward slashes; Docker Desktop handles the conversion)
#   Alternatively, set USERPROFILE in the .env and reference it:
#   DOWNLOADS_ROOT_HOST=${USERPROFILE}/Downloads
#
# The backend will place files under:
#   <DOWNLOADS_ROOT_HOST>/YT-Video Downloader/Single Videos/
#   <DOWNLOADS_ROOT_HOST>/YT-Video Downloader/Shorts/
#   <DOWNLOADS_ROOT_HOST>/YT-Video Downloader/Playlists/<title>/
DOWNLOADS_ROOT_HOST=${HOME}/Downloads


# ── Local hostname ─────────────────────────────────────────────────────────────
# The hostname used in the mkcert certificate and nginx server_name.
# Must match the entry you add to your hosts file (see README § mkcert Setup).
# Default: ytdownloader.local
LOCAL_HOSTNAME=ytdownloader.local


# ── bgutil PO Token provider ───────────────────────────────────────────────────
# Internal Docker service name + port. Do not change unless you rename the
# bgutil-provider service in docker-compose.yml.
# The backend reads this env var to locate the provider.
POT_PROVIDER_BASE_URL=http://bgutil-provider:4416
